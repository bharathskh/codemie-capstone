{
  "name": "codemie-capstone",
  "version": "1.0.0",
  "private": true,
  "description": "Capstone - login flow demo",
  "main": "src/server.js",
  "files": [
    "src",
    "public",
    "Dockerfile"
  ],
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "build": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && npm pack --pack-destination dist",
    "build:docker": "docker build -t codemie-capstone:latest .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "report": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "test:bdd": "playwright test --config=playwright.bdd.config.js",
    "report:bdd": "allure generate allure-results-bdd --clean -o allure-report-bdd",
    "report:bdd:open": "allure open allure-report-bdd"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "express": "^4.19.2",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "playwright-bdd": "^9.2.0"
  }
}
